{
  "$comment": "GitFig example — map this file to Variables with Collection Name 'breakpoints' (breakpoints + boolean token examples), then press Pull to create the variables in Figma. Keys starting with $ (like this comment) are ignored on import and preserved on push. Setup guide: https://docs.gitfig.com/design-sync/file-mappings",
  "breakpoint": {
    "sm": { "$value": 640, "$type": "number", "$description": "Small tablets and up" },
    "md": { "$value": 768, "$type": "number", "$description": "Tablets and up" },
    "lg": { "$value": 1024, "$type": "number", "$description": "Laptops and up" },
    "xl": { "$value": 1280, "$type": "number", "$description": "Desktops and up" },
    "2xl": { "$value": 1536, "$type": "number", "$description": "Wide desktops" }
  },
  "container": {
    "gutter-mobile": { "$value": 16, "$type": "number" },
    "gutter-desktop": { "$value": 32, "$type": "number" },
    "max-width": { "$value": 1200, "$type": "number", "$description": "Content max width" }
  },
  "feature-flags": {
    "rounded-buttons": { "$value": true, "$type": "boolean", "$description": "Boolean token example" },
    "dense-tables": { "$value": false, "$type": "boolean" }
  }
}
